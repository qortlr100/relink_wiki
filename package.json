{
  "name": "relink-wiki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/wiki run dev --",
    "dev:wiki": "pnpm --filter @relink-wiki/wiki dev",
    "dev:admin": "pnpm --filter @relink-wiki/mining-admin dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "corepack pnpm -r build && corepack pnpm site:package",
    "site:package": "node scripts/package-site-artifact.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
